# Optional legacy migration only. Not used by the ApplyWise app at runtime.
POSTGRES_DB=applywise
POSTGRES_USER=applywise
POSTGRES_PASSWORD=replace-with-the-password-you-already-use

# Local MongoDB connection for the ApplyWise app.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=applywise
COOKIE_SECURE=false

# Gemini API key for development. Keep the real value in .env, never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: local account that the read-only ApplyWise MCP server is allowed to access.
APPLYWISE_MCP_USER_EMAIL=

